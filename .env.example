# chaoxi 配置文件 — 复制为 .env 后修改
# 所有配置项均有默认值，.env 非必需，仅用于覆盖默认值。

# === cninfo API ===
# CNINFO_BASE_URL=https://www.cninfo.com.cn/new
# CNINFO_STATIC_URL=https://static.cninfo.com.cn
# CNINFO_TIMEOUT=30

# === 查询默认值 ===
# DEFAULT_LOOKBACK_DAYS=90
# MAX_PAGES=100
# MAX_CONCURRENT=4
# REQUEST_INTERVAL=0.5

# === 下载 ===
# DOWNLOAD_CONFIRM_THRESHOLD=50

# === 输出 ===
# CHAOXI_OUTPUT_DIR=./chaoxi_output

# === 日志 ===
# MAX_LOG_LINES=500

# === 变体排除 ===
# EXCLUDE_KEYWORDS=摘要,确认意见,取消,更正,补充,提示,致歉,修订,英文

# === 代理 ===
# HTTP_PROXY=
# HTTPS_PROXY=
